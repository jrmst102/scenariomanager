# Required
SESSION_SECRET=change-me-to-a-random-secret
JWT_SECRET=change-me-to-another-random-secret

# DigitalOcean Spaces (required for production, falls back to local filesystem)
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_KEY=your-spaces-key
SPACES_SECRET=your-spaces-secret
SPACES_BUCKET=your-bucket-name
SPACES_REGION=nyc3

# Optional
APP_URL=http://localhost:8000
PORT=8000

# OpenAI (optional — LLM features degrade gracefully)
OPENAI_API_KEY=
LLM_ENABLED=true
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=14000
OPENAI_MAX_RETRIES=0
