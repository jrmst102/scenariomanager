{
  "version": "1.0",
  "problemId": "b7e2a1f4-3c8d-4e9b-a5f6-1d2e3f4a5b6c",
  "title": "Apex Fitness: Platform Growth Strategy",
  "description": "Apex Fitness is a connected fitness platform (smart bikes, treadmills, and a subscription app) with $220M in annual revenue and 1.4M active subscribers. Growth has slowed from 35% to 9% YoY as the post-pandemic home fitness surge fades. The CEO has secured board approval for a $40M strategic investment and must decide how to allocate it. The competitive landscape is shifting: Peloton is restructuring after overexpansion, Apple Fitness+ is bundling aggressively, and boutique studios are recapturing in-person demand. The team must evaluate four strategic options and determine which holds up across multiple plausible futures.",
  "createdAt": "2026-03-18T09:15:00Z",
  "updatedAt": "2026-03-21T14:42:00Z",
  "axes": {
    "x": {
      "label": "Consumer Preference for At-Home vs. In-Person Fitness",
      "lowPole": {
        "label": "Return to gym",
        "description": "Consumers increasingly prefer in-person fitness experiences. Boutique studio memberships rebound to pre-pandemic levels. Social motivation and community drive gym attendance. At-home equipment usage declines as novelty fades and resale markets flood with used hardware."
      },
      "highPole": {
        "label": "At-home dominance",
        "description": "At-home fitness becomes the default for a majority of regular exercisers. Hybrid work normalizes home workouts. Connected fitness hardware improves (AR/VR integration, AI coaching). Gym membership growth stalls as consumers prioritize convenience and flexibility."
      }
    },
    "y": {
      "label": "Big Tech Entry into Connected Fitness",
      "lowPole": {
        "label": "Limited entry",
        "description": "Apple, Google, and Amazon treat fitness as a peripheral feature rather than a strategic priority. Apple Fitness+ remains a lightweight add-on. No major hardware launches from big tech. The connected fitness market remains accessible to specialist players."
      },
      "highPole": {
        "label": "Aggressive entry",
        "description": "Apple launches dedicated fitness hardware with deep Health app integration. Google/Fitbit expands into connected equipment. Amazon bundles fitness subscriptions with Prime. Big tech subsidizes hardware to acquire subscribers, compressing margins industry-wide."
      }
    }
  },
  "scenarios": [
    {
      "id": "Q1",
      "name": "Golden Age",
      "xPole": "high",
      "yPole": "low",
      "narrative": "At-home fitness becomes the dominant modality and big tech stays on the sidelines. Apex operates in a growing market without existential competitive pressure. Subscribers value premium content and specialized hardware. This is the best-case scenario for the current business model — the question is how to maximize the opportunity."
    },
    {
      "id": "Q2",
      "name": "Platform War",
      "xPole": "high",
      "yPole": "high",
      "narrative": "At-home fitness wins, but Apple, Google, and Amazon flood the market with subsidized hardware and bundled subscriptions. Apex faces a demand tailwind but brutal competitive pressure on pricing and subscriber acquisition. Survival depends on differentiation, community lock-in, or finding a niche that big tech ignores."
    },
    {
      "id": "Q3",
      "name": "Perfect Storm",
      "xPole": "low",
      "yPole": "high",
      "narrative": "Consumers return to gyms and studios while big tech simultaneously enters connected fitness. Apex faces shrinking demand and overwhelming competition. Hardware sales collapse. The subscription base erodes from both sides. This is the existential threat scenario — only the most defensible strategy survives."
    },
    {
      "id": "Q4",
      "name": "Niche Specialist",
      "xPole": "low",
      "yPole": "low",
      "narrative": "Consumers prefer in-person fitness but big tech doesn't aggressively enter the connected space. The at-home market shrinks but remains viable for dedicated enthusiasts. Apex can't rely on market growth but faces manageable competition. The play is to own the committed segment rather than chase mass adoption."
    }
  ],
  "alternatives": [
    {
      "id": "A",
      "name": "Double Down on Content & Community",
      "description": "Invest $40M in premium live and on-demand content, celebrity instructor partnerships, gamification features, and social community tools. Goal: make the subscription so valuable that hardware becomes secondary. Reduce hardware margins to drive installed base, then monetize through content."
    },
    {
      "id": "B",
      "name": "Launch B2B Corporate Wellness Platform",
      "description": "Invest $40M to build a corporate wellness offering — employer-subsidized subscriptions, office gym integrations, wellness analytics dashboards for HR, and group challenges. Target the $80B corporate wellness market. Diversifies revenue away from consumer discretionary spending."
    },
    {
      "id": "C",
      "name": "Acquire Boutique Studio Chain",
      "description": "Invest $40M to acquire a mid-size boutique fitness studio chain (e.g., 40–60 locations) and create a hybrid model: in-studio classes streamed to at-home subscribers, studio members get free app access, unified membership across physical and digital. Hedges against the return-to-gym trend."
    },
    {
      "id": "D",
      "name": "Build AI Personal Training Platform",
      "description": "Invest $40M in AI-powered personalized coaching: computer vision form correction, adaptive programming, real-time biometric optimization, and nutrition integration. Position Apex as a technology company, not a content company. Create a moat that big tech's bundled offerings can't easily replicate."
    }
  ],
